# Server
PORT=4000
NODE_ENV=development

# MongoDB
# 우선순위: MONGODB_ATLAS_URL(Atlas) > MONGO_URI(로컬)
# MONGODB_ATLAS_URL 값이 비어 있을 때만 MONGO_URI 가 사용됨.
MONGODB_ATLAS_URL=
MONGO_URI=mongodb://127.0.0.1:27017/shopping_mall_demo

# CORS (comma separated origins, * for any)
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Mail (Ethereal for dev — leave empty to auto-create a test account)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Shopping Mall Demo <no-reply@example.com>"
APP_BASE_URL=http://localhost:5173

# PortOne V2 REST API — 결제 검증/취소용
# 발급: PortOne 콘솔(admin.portone.io) > 결제연동 > 식별코드·API Keys > V2 API 탭
# V1 SDK(IMP.request_pay) 사용 중이라도 PortOne 채널이 V2(channel-key-xxx)면
# 결제건이 V2 시스템에 기록되므로 검증도 V2 REST API 로 해야 함.
# 결제 검증 기능을 안 쓰면 비워둬도 서버는 정상 기동.
PORTONE_V2_API_SECRET=
