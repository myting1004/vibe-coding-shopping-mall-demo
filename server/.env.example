# Server
PORT=4000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/shopping_mall_demo

# CORS (comma separated origins, * for any)
CORS_ORIGIN=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d

# Cookie
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Mail (Ethereal for dev — leave empty to auto-create a test account)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Shopping Mall Demo <no-reply@example.com>"
APP_BASE_URL=http://localhost:5173
